<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- En el menú «Acción» de la ficha y de la lista de contactos
         (models/res_partner.py). -->
    <record id="action_partner_enlazar_whatsapp" model="ir.actions.server">
        <field name="name">Enlazar con WhatsApp</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="binding_model_id" ref="base.model_res_partner" />
        <field name="binding_view_types">form,list</field>
        <field name="group_ids" eval="[(4, ref('mail_gateway.gateway_user'))]" />
        <field name="state">code</field>
        <field name="code">action = records.accion_enlazar_whatsapp()</field>
    </record>
    <record id="action_partner_plantilla_whatsapp" model="ir.actions.server">
        <field name="name">Enviar plantilla de WhatsApp</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="binding_model_id" ref="base.model_res_partner" />
        <field name="binding_view_types">form,list</field>
        <field name="group_ids" eval="[(4, ref('mail_gateway.gateway_user'))]" />
        <field name="state">code</field>
        <field name="code">action = records.accion_enviar_plantilla_whatsapp()</field>
    </record>
</odoo>
