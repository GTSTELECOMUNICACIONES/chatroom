<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- «+ Nueva conversación» del lateral de Chats (David, 26-11-2026). -->
    <record id="gts_chatroom_nueva_form" model="ir.ui.view">
        <field name="name">gts.chatroom.nueva.form</field>
        <field name="model">gts.chatroom.nueva</field>
        <field name="arch" type="xml">
            <form string="Nueva conversación">
                <group name="quien">
                    <group name="contacto">
                        <field name="partner_id" options="{'no_create': True}" />
                        <field name="telefono" invisible="not partner_id" />
                    </group>
                    <group name="canal">
                        <field name="gateway_id" options="{'no_create': True, 'no_open': True}" />
                        <field name="canal_id" invisible="1" />
                        <field name="ventana_abierta" invisible="1" />
                    </group>
                </group>
                <div class="alert alert-success py-2" role="status" invisible="not ventana_abierta">
                    Te ha escrito en las últimas 24 horas: no hace falta plantilla. Pulsa
                    «Abrir la conversación» y escríbele directamente.
                </div>
                <div class="alert alert-info py-2" role="status" invisible="ventana_abierta or not partner_id">
                    Para escribirle hace falta una plantilla aprobada (Meta lo exige si no te ha
                    escrito en las últimas 24 horas). Vale cualquiera: de utilidad o de marketing.
                </div>
                <group name="plantilla">
                    <field name="plantilla_id" options="{'no_create': True}" />
                    <field name="categoria_texto" invisible="not plantilla_id" />
                </group>
                <div invisible="not variables">
                    <div class="alert alert-light py-2 my-2" role="status" invisible="not ejemplo_texto">
                        Así se la enseñamos a Meta: <i><field name="ejemplo_texto" readonly="1" class="d-inline" /></i>
                    </div>
                    <field name="dato_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="posicion" readonly="1" width="60px" />
                            <field name="pista" readonly="1" />
                            <field name="ejemplo" readonly="1" optional="hide" />
                            <field name="valor" placeholder="Escribe aquí, en una sola línea" />
                        </list>
                    </field>
                </div>
                <group name="previa" invisible="not plantilla_id" string="Así llegará">
                    <field name="vista_previa" nolabel="1" colspan="2" readonly="1" />
                </group>
                <footer>
                    <button name="accion_enviar" type="object" string="Enviar" class="btn-primary" invisible="not plantilla_id" />
                    <button name="accion_abrir" type="object" string="Abrir la conversación" class="btn-secondary" />
                    <button special="cancel" string="Cancelar" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_chatroom_nueva" model="ir.actions.act_window">
        <field name="name">Nueva conversación</field>
        <field name="res_model">gts.chatroom.nueva</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- «Pasar a otra persona», desde la cabecera del chat (26-11-2026). -->
    <record id="gts_chatroom_pasar_form" model="ir.ui.view">
        <field name="name">gts.chatroom.pasar.form</field>
        <field name="model">gts.chatroom.pasar</field>
        <field name="arch" type="xml">
            <form string="Pasar a otra persona">
                <group name="pasar">
                    <field name="canal_id" readonly="1" options="{'no_open': True}" />
                    <field name="usuario_id" options="{'no_create': True, 'no_open': True}" />
                </group>
                <div class="text-muted small">
                    La conversación pasa a su «Para mí» y queda anotado quién se la pasó.
                </div>
                <footer>
                    <button name="accion_pasar" type="object" string="Pasar" class="btn-primary" />
                    <button special="cancel" string="Cancelar" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
