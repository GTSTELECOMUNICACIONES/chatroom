<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <menuitem
        id="menu_chatroom_root"
        name="ChatRoom"
        web_icon="gts_chatroom,static/description/icon.png"
        groups="mail_gateway.gateway_user"
        sequence="45"
    />
    <!-- Lo primero al entrar: los chats, como en WhatsApp (David,
         25-11-2026). Las listas de Conversaciones y Esperando siguen. -->
    <menuitem
        id="menu_chatroom_chats"
        name="Chats"
        parent="menu_chatroom_root"
        action="action_chatroom_chats"
        sequence="5"
    />
    <!-- Una bandeja por canal, como los buzones de Outlook. Las secciones
         y sus vistas las crea el código al dar de alta un canal
         (models/gts_chatroom_canal.py). -->
    <!-- Desactivado el 26-11-2026 (David): las bandejas ya están en el
         lateral de Chats. El código que las genera sigue; con el menú
         padre archivado no salen. -->
    <menuitem
        id="menu_chatroom_bandejas"
        name="Bandejas"
        parent="menu_chatroom_root"
        sequence="7"
        active="False"
    />
    <menuitem
        id="menu_chatroom_conversaciones"
        name="Conversaciones"
        parent="menu_chatroom_root"
        action="discuss_channel_alma_action"
        sequence="10"
    />
    <!-- El nombre lleva el numero de las que esperan: lo pone
         models/ir_ui_menu.py al cargar los menus. -->
    <menuitem
        id="menu_chatroom_esperando"
        name="Esperando"
        parent="menu_chatroom_root"
        action="discuss_channel_alma_esperando_action"
        sequence="20"
    />
    <!-- Comunicados y plantillas (David, 25-11-2026). -->
    <menuitem
        id="menu_chatroom_comunicados_raiz"
        name="Comunicados"
        parent="menu_chatroom_root"
        sequence="30"
    />
    <menuitem
        id="menu_chatroom_comunicados"
        name="Comunicados"
        parent="menu_chatroom_comunicados_raiz"
        action="gts_chatroom_comunicado_action"
        sequence="10"
    />
    <menuitem
        id="menu_chatroom_listas"
        name="Listas de difusión"
        parent="menu_chatroom_comunicados_raiz"
        action="gts_chatroom_lista_action"
        sequence="20"
    />
    <menuitem
        id="menu_chatroom_plantillas"
        name="Plantillas"
        parent="menu_chatroom_root"
        action="gts_chatroom_plantilla_action"
        sequence="40"
    />
    <!-- «Créditos» se quitó el 26-11-2026: la pantalla de facturación del
         portal es la de agentes de voz y no le dice nada a un cliente del
         ChatRoom. Vuelve cuando exista la del monedero; el método
         `mail.gateway._gts_abrir_portal` sigue escrito. -->
    <!-- La versión, para que cualquiera la diga al reportar un problema. El
         nombre («v0.11.7») lo pone models/ir_ui_menu.py al cargar los menús. -->
    <record id="action_chatroom_version" model="ir.actions.server">
        <field name="name">Versión del ChatRoom</field>
        <field name="model_id" ref="base.model_ir_ui_menu" />
        <field name="state">code</field>
        <field name="code">action = model._gts_aviso_de_version()</field>
        <field name="groups_id" eval="[(4, ref('mail_gateway.gateway_user'))]" />
    </record>
    <menuitem
        id="menu_chatroom_version"
        name="Versión"
        parent="menu_chatroom_root"
        action="action_chatroom_version"
        sequence="99"
    />
    <menuitem
        id="menu_chatroom_config"
        name="Configuración"
        parent="menu_chatroom_root"
        groups="base.group_system"
        sequence="90"
    />
    <menuitem
        id="menu_chatroom_pasarelas"
        name="Canales"
        parent="menu_chatroom_config"
        action="mail_gateway_alma_action"
        sequence="10"
    />
    <menuitem
        id="menu_chatroom_buzones"
        name="Buzones"
        parent="menu_chatroom_config"
        action="action_chatroom_buzones"
        sequence="5"
    />
    <menuitem
        id="menu_chatroom_ajustes"
        name="Ajustes"
        parent="menu_chatroom_config"
        action="gts_chatroom_config_settings_action"
        sequence="20"
    />
</odoo>
