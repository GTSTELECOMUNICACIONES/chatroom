<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form (gts_chatroom)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    data-string="ChatRoom"
                    string="ChatRoom"
                    name="gts_chatroom"
                    groups="base.group_system"
                >
                    <block title="Conversaciones que esperan" name="gts_chatroom_esperas">
                        <setting
                            id="gts_chatroom_aviso_espera"
                            string="Aviso cuando nadie la coge"
                            help="Si una conversación lleva este tiempo esperando a una persona y nadie la ha cogido, se crea una actividad para el responsable. Se cierra sola cuando alguien la atiende."
                        >
                            <div class="content-group">
                                <div class="mt8">
                                    <label for="alma_minutos_aviso" class="o_light_label me-2" />
                                    <field name="alma_minutos_aviso" class="oe_inline" />
                                </div>
                                <div class="mt8">
                                    <label for="alma_responsable_id" class="o_light_label me-2" />
                                    <field
                                        name="alma_responsable_id"
                                        class="oe_inline"
                                        placeholder="El administrador"
                                    />
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="gts_chatroom_config_settings_action" model="ir.actions.act_window">
        <field name="name">Ajustes</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'gts_chatroom', 'bin_size': False}</field>
    </record>
</odoo>
