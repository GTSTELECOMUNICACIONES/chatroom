<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="gts_chatroom_expediente_guardar_form" model="ir.ui.view">
        <field name="name">gts.chatroom.expediente.guardar.form</field>
        <field name="model">gts.chatroom.expediente.guardar</field>
        <field name="arch" type="xml">
            <form string="Guardar en el expediente">
                <div class="alert alert-warning py-2" role="alert" invisible="not aviso">
                    <field name="aviso" />
                </div>
                <group name="principal">
                    <field name="adjunto_id" options="{'no_open': True}" />
                    <field name="canal_id" invisible="not canal_id" options="{'no_open': True}" />
                    <field name="partner_id" invisible="not partner_id" />
                    <field name="expediente_id" options="{'no_create': True}" />
                    <field name="hay_carpetas" invisible="1" />
                    <field name="carpeta" invisible="not hay_carpetas" placeholder="04 Documentación del cliente" />
                    <field name="carpetas_texto" invisible="not hay_carpetas" />
                </group>
                <footer>
                    <button name="action_guardar" type="object" string="Guardar en el expediente" class="btn-primary" />
                    <button special="cancel" string="Cancelar" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_gts_chatroom_expediente_guardar" model="ir.actions.act_window">
        <field name="name">Guardar en el expediente</field>
        <field name="res_model">gts.chatroom.expediente.guardar</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
